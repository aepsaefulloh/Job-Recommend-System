
@startuml UML Class Diagram - Job Recommendation System

class SurveyData {
    - id: int
    - email: string
    - nama: string
    - tempat_tinggal: string
    - jurusan: string
    - status_bekerja: string
    --
    - profesi_sekarang: string
    - jenis_perusahaan: string
    - gaji: float
    --
    - jurusan_cocok: string
    - perusahaan_tepat: string
    --
    - created_at: datetime
    - updated_at: datetime
    --
    + save(): void
    + update(): void
    + delete(): void
    + get_recommendations(): list
}

class User {
    - id: int
    - username: string
    - email: string
    - password: string
    - full_name: string
    - role: string
    - is_active: boolean
    --
    - created_at: datetime
    - last_login: datetime
    --
    + set_password(password: string): void
    + check_password(password: string): boolean
    + login(): boolean
    + logout(): void
}

class DashboardStats {
    - id: int
    - stat_name: string
    - stat_value: float
    - stat_type: string
    - updated_at: datetime
    --
    + update(): void
    + calculate(): float
    + get_value(): float
}

class Predictor {
    - knn_jurusan: KNeighborsClassifier
    - knn_perusahaan: KNeighborsClassifier
    - scaler: StandardScaler
    - label_encoders: dict
    --
    + preprocess_form_data(form_data: dict): dict
    + encode_features(data: dict): array
    + make_predictions(data: dict): dict
    + load_models(): boolean
}

class KNNModel {
    - n_neighbors: int
    - weights: string
    - metric: string
    --
    + fit(X, y): void
    + predict(X): array
    + predict_proba(X): array
}

' Relationships
SurveyData "1" -- "*" User : owned by
DashboardStats "*" -- "1" SurveyData : calculated from
Predictor --> SurveyData : uses
Predictor --> KNNModel : contains
User --> DashboardStats : admin access

' Interface
interface "MLModel" {
    + fit(X, y): void
    + predict(X): array
}

KNNModel ..|> MLModel : implements

@enduml
